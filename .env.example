# Google Cloud service account (Sheets API enabled), shared as Editor on the target Sheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=ppe-system@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExampleKeyContentsHere\n-----END PRIVATE KEY-----\n"

# The Google Sheet that acts as the database — the long ID in its URL
SHEET_ID=1AbCDeFGhIJkLmNoPQrSTuVwxYZ0123456789abcdefg

# Any long random string — used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-this-with-a-random-64-character-string
